PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only — never prefix with PUBLIC_. Paste from Supabase → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Password for the “New Recipe” form (/admin/new). Set the same value in Netlify (secret).
ADMIN_PASSWORD=
